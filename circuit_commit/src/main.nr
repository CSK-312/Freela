// Generated by generate_circuit.py. Run with `nargo execute` by the issuer only:
// prints the commitment stored as the freelancer's current credential.
fn main(
    applicant_id: Field,
    salt: Field,
    ratings: [u32; 64],
    on_time: [u32; 64],
    disputed: [u32; 64],
    valid: [u32; 64]
) -> pub Field {
    history_commitment(applicant_id, salt, ratings, on_time, disputed, valid)
}

// Pedersen commitment to one freelancer's complete padded history, bound to their account id.
// Each record packs into one field element: rating * 8 + on_time * 4 + disputed * 2 + valid.
// The eligibility circuit range-checks every value, so the packing is unambiguous.
fn history_commitment(
    applicant_id: Field,
    salt: Field,
    ratings: [u32; 64],
    on_time: [u32; 64],
    disputed: [u32; 64],
    valid: [u32; 64]
) -> Field {
    let mut packed: [Field; 66] = [0; 66];
    packed[0] = applicant_id;
    packed[1] = salt;
    for i in 0..64 {
        packed[i + 2] = (ratings[i] as Field) * 8 + (on_time[i] as Field) * 4
            + (disputed[i] as Field) * 2 + (valid[i] as Field);
    }
    std::hash::pedersen_hash(packed)
}
