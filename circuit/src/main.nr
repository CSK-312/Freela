// Generated by generate_circuit.py.
// Proves: the private history is exactly the one committed to in the applicant's current
// credential, and it meets the job's public thresholds. Each aligned index is one
// completed, rated job; zero rows are padding.
fn main(
    ratings: [u32; 64],
    on_time: [u32; 64],
    disputed: [u32; 64],
    valid: [u32; 64],
    salt: Field,
    min_rating_scaled: pub u32,
    min_completed_jobs: pub u32,
    min_on_time_rate: pub u32,
    max_disputes: pub u32,
    job_id: pub Field,
    applicant_id: pub Field,
    commitment: pub Field
) {
    // job_id and applicant_id are public inputs, so a proof cannot be replayed
    // for another job or person: the verifier checks them against the application.
    assert(job_id != 0);
    assert(applicant_id != 0);
    assert(history_commitment(applicant_id, salt, ratings, on_time, disputed, valid) == commitment);

    assert(min_rating_scaled >= 100);
    assert(min_rating_scaled <= 500);
    assert(min_on_time_rate <= 100);

    let mut jobs: u64 = 0;
    let mut rating_sum: u64 = 0;
    let mut on_time_count: u64 = 0;
    let mut dispute_count: u64 = 0;
    for i in 0..64 {
        assert(valid[i] <= 1);
        assert(on_time[i] <= 1);
        assert(disputed[i] <= 1);
        if valid[i] == 1 {
            assert(ratings[i] >= 100);
            assert(ratings[i] <= 500);
            jobs += 1;
            rating_sum += ratings[i] as u64;
            on_time_count += on_time[i] as u64;
            dispute_count += disputed[i] as u64;
        } else {
            assert(ratings[i] == 0);
            assert(on_time[i] == 0);
            assert(disputed[i] == 0);
        }
    }
    // No division or rounded averages: all four metrics are derived here.
    assert(jobs > 0);
    assert(jobs >= min_completed_jobs as u64);
    assert(rating_sum >= (min_rating_scaled as u64) * jobs);
    assert(100 * on_time_count >= (min_on_time_rate as u64) * jobs);
    assert(dispute_count <= max_disputes as u64);
}

// Pedersen commitment to one freelancer's complete padded history, bound to their account id.
// Each record packs into one field element: rating * 8 + on_time * 4 + disputed * 2 + valid.
// The eligibility circuit range-checks every value, so the packing is unambiguous.
fn history_commitment(
    applicant_id: Field,
    salt: Field,
    ratings: [u32; 64],
    on_time: [u32; 64],
    disputed: [u32; 64],
    valid: [u32; 64]
) -> Field {
    let mut packed: [Field; 66] = [0; 66];
    packed[0] = applicant_id;
    packed[1] = salt;
    for i in 0..64 {
        packed[i + 2] = (ratings[i] as Field) * 8 + (on_time[i] as Field) * 4
            + (disputed[i] as Field) * 2 + (valid[i] as Field);
    }
    std::hash::pedersen_hash(packed)
}

// Test helper: proves for applicant 3 / job 7 with a commitment matching the given history.
fn check(
    ratings: [u32; 64],
    on_time: [u32; 64],
    disputed: [u32; 64],
    valid: [u32; 64],
    min_rating_scaled: u32,
    min_completed_jobs: u32,
    min_on_time_rate: u32,
    max_disputes: u32
) {
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    main(ratings, on_time, disputed, valid, 12345, min_rating_scaled, min_completed_jobs,
         min_on_time_rate, max_disputes, 7, 3, commitment);
}

fn two_good_jobs() -> ([u32; 64], [u32; 64], [u32; 64], [u32; 64]) {
    let mut ratings: [u32; 64] = [0; 64];
    ratings[0] = 500;
    ratings[1] = 500;
    let mut on_time: [u32; 64] = [0; 64];
    on_time[0] = 1;
    on_time[1] = 1;
    let disputed: [u32; 64] = [0; 64];
    let mut valid: [u32; 64] = [0; 64];
    valid[0] = 1;
    valid[1] = 1;
    (ratings, on_time, disputed, valid)
}

#[test]
fn test_matching_commitment_passes() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    check(ratings, on_time, disputed, valid, 500, 2, 100, 0);
}

#[test(should_fail)]
fn test_history_changed_after_issuance() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    let mut edited = ratings;
    edited[0] = 499;
    main(edited, on_time, disputed, valid, 12345, 100, 1, 0, 0, 7, 3, commitment);
}

#[test(should_fail)]
fn test_dropped_record_after_issuance() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    let mut fewer_ratings = ratings;
    fewer_ratings[1] = 0;
    let mut fewer_on_time = on_time;
    fewer_on_time[1] = 0;
    let mut fewer_valid = valid;
    fewer_valid[1] = 0;
    main(fewer_ratings, fewer_on_time, disputed, fewer_valid, 12345, 100, 1, 0, 0, 7, 3, commitment);
}

#[test(should_fail)]
fn test_someone_elses_credential() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    main(ratings, on_time, disputed, valid, 12345, 100, 1, 0, 0, 7, 4, commitment);
}

#[test(should_fail)]
fn test_wrong_salt() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    main(ratings, on_time, disputed, valid, 54321, 100, 1, 0, 0, 7, 3, commitment);
}

#[test(should_fail)]
fn test_zero_job_id() {
    let (ratings, on_time, disputed, valid) = two_good_jobs();
    let commitment = history_commitment(3, 12345, ratings, on_time, disputed, valid);
    main(ratings, on_time, disputed, valid, 12345, 100, 1, 0, 0, 0, 3, commitment);
}

#[test]
fn test_exact_boundaries() {
    let mut ratings: [u32; 64] = [0; 64];
    ratings[0] = 480;
    ratings[1] = 500;
    let mut on_time: [u32; 64] = [0; 64];
    on_time[0] = 1;
    on_time[1] = 0;
    let mut disputed: [u32; 64] = [0; 64];
    disputed[0] = 1;
    disputed[1] = 0;
    let mut valid: [u32; 64] = [0; 64];
    valid[0] = 1;
    valid[1] = 1;
    check(ratings, on_time, disputed, valid, 490, 2, 50, 1);
}

#[test]
fn test_padding_does_not_count() {
    let mut ratings: [u32; 64] = [0; 64];
    ratings[0] = 500;
    ratings[1] = 0;
    let mut on_time: [u32; 64] = [0; 64];
    on_time[0] = 1;
    on_time[1] = 0;
    let mut disputed: [u32; 64] = [0; 64];
    disputed[0] = 0;
    disputed[1] = 0;
    let mut valid: [u32; 64] = [0; 64];
    valid[0] = 1;
    valid[1] = 0;
    check(ratings, on_time, disputed, valid, 500, 1, 100, 0);
}

